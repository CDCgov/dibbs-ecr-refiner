# `local` keeps the AWS Runtime Interface Emulator so the container can serve
# invocations on its own (docker-compose.yml targets this stage). The final
# stage is what gets built by default, pushed, and deployed.
FROM public.ecr.aws/lambda/python:3.15 AS local

WORKDIR ${LAMBDA_TASK_ROOT}

# default VERSION is 0.0.0 if not passed at build time
ARG VERSION="0.0.0"

# make it available as an environment variable inside the container
ENV VERSION=$VERSION

# The base image pins its AL2023 release, so a plain `dnf upgrade` is a no-op.
# Upgrade to the latest release to pick up security fixes the base image lags
# on. This runs before the CA trust edit below so a ca-certificates upgrade
# cannot undo it.
RUN dnf upgrade -y --refresh --releasever=latest \
    && dnf clean all

# AL2023's ca-certificates still ships two roots distrusted after the eMudhra CA
# key compromise: emSign ECC Root CA - G3 and Comodo's AAA Certificate Services.
# Drop them from the trust source and re-extract every bundle. This is a no-op
# once AL2023 ships a fixed package.
RUN gawk -i inplace -v RS= -v ORS='\n\n' \
    '!/\nlabel: "(emSign ECC Root CA - G3|Comodo AAA Services root)"\n/' \
    /usr/share/pki/ca-trust-source/ca-bundle.trust.p11-kit \
    && update-ca-trust extract

# Install dependencies, then remove pip. Nothing needs it at runtime, and pip
# vendors part of an old setuptools release that scanners flag through the SBOM
# pip ships (pip/_vendor/bom.cdx.json).
COPY ./refiner/app/lambda/requirements.txt .
COPY ./refiner/packages/dibbs-ecr/ ./packages/dibbs-ecr/

RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir ./packages/dibbs-ecr \
    && python -m pip uninstall -y pip

# Copy handler
COPY ./refiner/app/lambda/lambda_function.py app/lambda/lambda_function.py

# Copy assets
COPY ./refiner/assets ./assets

# Copy refiner modules. `app/db` is deliberately absent: the Lambda has no database
# connection, and `tests/unit/test_layering.py` asserts the handler reaches nothing
# under `app.db` so this stays true. the S3 payload shapes it used to import from
# there now live in `app/core/models/payloads.py`
COPY ./refiner/app/core app/core
COPY ./refiner/app/services app/services

# Fail the build if either distrusted root is left in any CA bundle, whether from
# the OS or vendored by a Python package. Each pattern is one line of a root's
# base64 body (emSign ECC Root CA - G3, then AAA Certificate Services), so it
# matches however a bundle labels the certificate. grep exits 1 only when
# nothing matched.
RUN grep -rlF \
    -e 'CUfvO6wIBHxcmbHtRwfSAjEAnbpV/KlK6O3t5nYBQnvI+GDZjVGLVTv7jHvrZQnD' \
    -e 'l2D4kF501KKaU73yqWjgom7C12yxow+ev+to51byrvLjKzg6CYG1a4XXvi3tPxq3' \
    /etc /usr /var; \
    test $? -eq 1

# Restore pip + hatchling for local dev editable installs
RUN python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir setuptools

# Handler entrypoint
CMD [ "app.lambda.lambda_function.lambda_handler" ]


# Deployed image. AWS Lambda always provides the Runtime API, so the base
# image's entrypoint never starts the emulator here, and removing it drops a
# binary that trails Go security releases. We also uninstall pip again so the
# SBOM scanner check stays clean in production.
FROM local AS production

RUN rm /usr/local/bin/aws-lambda-rie \
    && python -m pip uninstall -y pip setuptools
